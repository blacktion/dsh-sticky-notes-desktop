{
  "name": "dsh-sticky-notes-desktop",
  "version": "0.1.1",
  "description": "Always-on-top desktop sticky notes for DeepSeek Harness: real OS windows, edge snapping that hides and reveals on hover, screenshot annotation, one-time and repeating note alarms.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blacktion/dsh-sticky-notes-desktop.git"
  },
  "homepage": "https://github.com/blacktion/dsh-sticky-notes-desktop#readme",
  "bugs": {
    "url": "https://github.com/blacktion/dsh-sticky-notes-desktop/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.bundle.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./locale/icon.svg": "./locale/icon.svg"
  },
  "files": [
    "lib",
    "electron",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "DEVELOPMENT.md",
    "DEVELOPMENT.zh.md",
    "LICENSE"
  ],
  "icon": "./locale/icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "prepack": "node tools/build-client.mjs --check",
    "test": "node tools/test-geometry.mjs && node tools/test-geometry-runtime.mjs && node tools/test-notes-runtime.mjs && node tools/test-alarm-schedule.mjs && node tools/test-package.mjs && node tools/check-readme-links.mjs && node tools/build-client.mjs --check && node tools/test-client-load.mjs && node tools/test-tool-registration.mjs && node tools/check-tool-schemas.mjs && node tools/check-swatch-css.mjs && node tools/test-version.mjs && node tools/test-version-check.mjs && node tools/test-delete-confirm.mjs && node tools/test-electron-helper.mjs && node tools/test-popup.mjs && node tools/test-popup-appearance.mjs && node tools/test-shot-actions.mjs && node tools/test-hide-modes.mjs && node tools/test-alarm-ring.mjs && node tools/test-note-appearance.mjs && node tools/test-helper-service.mjs && node tools/test-bridge.mjs",
    "check": "node tools/build-client.mjs --check",
    "check:readme": "node tools/check-readme-links.mjs",
    "check:schemas": "node tools/check-tool-schemas.mjs",
    "check:swatches": "node tools/check-swatch-css.mjs",
    "test:version": "node tools/test-version.mjs",
    "test:version-check": "node tools/test-version-check.mjs",
    "test:delete-confirm": "node tools/test-delete-confirm.mjs",
    "test:note-drag": "node tools/test-note-drag-focus.mjs",
    "test:geometry": "node tools/test-geometry.mjs",
    "test:geometry-runtime": "node tools/test-geometry-runtime.mjs",
    "test:notes-runtime": "node tools/test-notes-runtime.mjs",
    "test:alarm-schedule": "node tools/test-alarm-schedule.mjs",
    "test:alarm-ring": "node tools/test-alarm-ring.mjs",
    "test:alarm-ui": "node tools/test-alarm-ui.mjs",
    "test:helper-service": "node tools/test-helper-service.mjs",
    "test:service-ui": "node tools/test-service-ui.mjs",
    "test:package": "node tools/test-package.mjs",
    "test:client": "node tools/build-client.mjs && node tools/test-client-load.mjs",
    "test:electron": "node tools/test-electron-helper.mjs",
    "test:popup": "node tools/test-popup.mjs",
    "test:popup-appearance": "node tools/test-popup-appearance.mjs",
    "test:shot": "node tools/test-shot-actions.mjs",
    "test:hide-modes": "node tools/test-hide-modes.mjs",
    "test:appearance": "node tools/test-note-appearance.mjs",
    "test:render": "node tools/render-note.mjs",
    "test:bridge": "node tools/test-helper-service.mjs && node tools/test-bridge.mjs",
    "test:live": "node tools/test-live.mjs",
    "test:ui": "node tools/test-ui.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes",
    "screenshot",
    "always-on-top"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
